{
  "name": "@rderet/n8n-nodes-format-template",
  "version": "0.1.0",
  "description": "n8n node for data transformation and formatting with extensible handlers.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "data-transformation",
    "formatting",
    "text-case",
    "phone-formatting",
    "country-codes"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rldet9/FormatTemplate",
  "author": {
    "name": "Raphael Deret",
    "email": "raphael.deret@mixtrio.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rldet9/FormatTemplate.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
