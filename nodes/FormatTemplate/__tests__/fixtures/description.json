{
	"displayName": "Format Template",
	"name": "formatTemplate",
	"icon": {
		"light": "file:FormatTemplate.svg",
		"dark": "file:FormatTemplate.dark.svg"
	},
	"group": [
		"transform"
	],
	"version": [
		5,
		6
	],
	"defaultVersion": 6,
	"description": "Overwrite properties with formatted values",
	"usableAsTool": true,
	"defaults": {
		"name": "Format Template"
	},
	"inputs": [
		"main"
	],
	"outputs": [
		"main"
	],
	"properties": [
		{
			"displayName": "Fields to Format",
			"name": "fieldsToFormat",
			"placeholder": "Add Field",
			"type": "fixedCollection",
			"typeOptions": {
				"multipleValues": true
			},
			"default": {},
			"options": [
				{
					"name": "field",
					"displayName": "Field",
					"values": [
						{
							"displayName": "Field Path",
							"name": "fieldPath",
							"type": "string",
							"default": "",
							"description": "Name of the property to format, in dot notation (e.g. \"phone\", \"client.phone\") — never its value",
							"placeholder": "e.g. phone",
							"requiresDataPath": "single",
							"typeOptions": {
								"expressionResultMemoize": true,
								"listPropertyValues": "keys",
								"multipleValues": false
							}
						},
						{
							"displayName": "Type",
							"name": "type",
							"type": "options",
							"default": "",
							"options": [
								{
									"name": "Phone",
									"value": "phone",
									"description": "Normalize phone numbers: national, international, E.164 or custom mask"
								},
								{
									"name": "Text Case",
									"value": "textCase",
									"description": "Change the case of a text: uppercase, lowercase, first letter or title case"
								},
								{
									"name": "Country Code",
									"value": "country",
									"description": "Convert country names to ISO 3166-1 alpha-2 codes (offline table)"
								},
								{
									"name": "Postal Address (France)",
									"value": "postalAddress",
									"description": "Verify a French address against the national address base and write it to the postal standard (NF Z10-011)"
								}
							]
						},
						{
							"displayName": "Pattern",
							"name": "pattern",
							"type": "options",
							"default": "{0:+33 (0) # ## ## ## ##}",
							"displayOptions": {
								"show": {
									"type": [
										"phone"
									],
									"@version": [
										5
									]
								}
							},
							"description": "Mask of typeVersion 5. Caution: in this version \"0\" consumes a digit, and the number of digits is not checked — see the node documentation.",
							"typeOptions": {
								"allowCustomValues": true
							},
							"options": [
								{
									"name": "+33 (0) # ## ## ## ## (FR International, National Input Only)",
									"value": "{0:+33 (0) # ## ## ## ##}"
								},
								{
									"name": "0# ## ## ## ## (FR National)",
									"value": "{0:0# ## ## ## ##}"
								},
								{
									"name": "(###) ###-#### (US)",
									"value": "{0:(###) ###-####}"
								}
							]
						},
						{
							"displayName": "Output Format",
							"name": "phoneOutput",
							"type": "options",
							"default": "national",
							"displayOptions": {
								"show": {
									"type": [
										"phone"
									],
									"@version": [
										6
									]
								}
							},
							"description": "Shape of the written value. Reading the input does not depend on it: \"+33 3 20 00 00 00\", \"0320000000\" and \"0033 3 20 00 00 00\" give the same result.",
