								{
									"name": "National (03 20 00 00 00)",
									"value": "national"
								},
								{
									"name": "International (+33 3 20 00 00 00)",
									"value": "international"
								},
								{
									"name": "E.164 (+33320000000)",
									"value": "e164"
								},
								{
									"name": "Custom Mask",
									"value": "mask"
								}
							]
